# =============================================================================
#  9router — variáveis de ambiente
#  Copie para ".env" (o `make init` faz isso e gera os segredos para você).
#  Referência completa: docs/CONFIGURACAO.md
# =============================================================================

# --- Rede ---------------------------------------------------------------------
PORT=20128
# 127.0.0.1 = só nesta máquina (recomendado). 0.0.0.0 = acessível na rede.
# (No Docker o container sempre usa 0.0.0.0; quem limita é o "ports" do compose.)
HOSTNAME=127.0.0.1
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NODE_ENV=production

# --- Dados --------------------------------------------------------------------
# Onde ficam banco (db/data.sqlite), backups automáticos e o jwt-secret.
# No Docker este valor é sobrescrito para /app/data (montado de DATA_DIR_HOST).
DATA_DIR_HOST=${HOME}/.9router

# --- Segurança (gerados pelo `make init`) -------------------------------------
JWT_SECRET=__GERAR__
API_KEY_SECRET=__GERAR__
MACHINE_ID_SALT=__GERAR__
# Senha do primeiro login no dashboard. TROQUE depois de entrar.
INITIAL_PASSWORD=__GERAR__

# Exigir API key (Bearer) em /v1/*. Use "true" se expuser fora do localhost.
REQUIRE_API_KEY=false
# Use "true" quando estiver atrás de HTTPS (reverse proxy).
AUTH_COOKIE_SECURE=false

# --- Diagnóstico --------------------------------------------------------------
ENABLE_REQUEST_LOGS=false

# --- Proxy de saída (opcional) ------------------------------------------------
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# --- Cloud sync (padrões do projeto) ------------------------------------------
CLOUD_URL=https://9router.com
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# --- Imagem Docker ------------------------------------------------------------
NINEROUTER_IMAGE=decolua/9router:latest
